-- ================= ฟังก์ชั่นอำนวยความสะดวก =================
local function getPrompts()
    local prompts = {}
    for _, obj in pairs(Workspace:GetDescendants()) do
        if obj:IsA("ProximityPrompt") then
            table.insert(prompts, obj)
        end
    end
    return prompts
end

-- ================= 1. ระบบซื้อเมล็ด (แบบแก้แลค) =================
task.spawn(function()
    while task.wait(0.5) do
        if Settings.AutoBuy then
            pcall(function()
                local prompts = getPrompts()
                for _, prompt in pairs(prompts) do
                    -- เช็คชื่อโมเดล หรือชื่อของปุ่ม ว่าตรงกับความหายากที่เลือกไหม
                    local parentName = prompt.Parent and prompt.Parent.Name:lower() or ""
                    local actionText = prompt.ActionText:lower()
                    local objectText = prompt.ObjectText:lower()
                    local targetRarity = Settings.SeedRarity:lower()
                    
                    if parentName:find(targetRarity) or actionText:find(targetRarity) or objectText:find(targetRarity) then
                        -- ถ้าเจอปุ่มซื้อเมล็ดระดับที่ต้องการ ให้ยิงคำสั่งเลย
                        fireproximityprompt(prompt)
                    end
                end
            end)
        end
    end
end)

-- ================= 2. ระบบดักเก็บก่อนฟ้าผ่าเสี้ยววิ (แบบ Event ดักจับทันที) =================
-- ทันทีที่มีเป้าสายฟ้า (Warning/Lightning) โผล่มาในแมพ มันจะทำงานทันที (ไวกว่าลูป)
Workspace.DescendantAdded:Connect(function(obj)
    if not Settings.AutoHarvest then return end
    
    -- รอให้ระบบโหลดชื่อและตำแหน่งแป๊บนึง
    task.wait(0.05) 
    
    pcall(function()
        local name = obj.Name:lower()
        -- ถ้าวัตถุที่โผล่มาเป็นสัญญาณเตือนฟ้าผ่า
        if name:find("lightning") or name:find("strike") or name:find("target") or name:find("warning") then
            if obj:IsA("BasePart") then
                local strikePos = obj.Position
                
                -- หาต้นไม้ที่อยู่ใกล้เป้าสายฟ้านั้น
                local prompts = getPrompts()
                for _, prompt in pairs(prompts) do
                    local plant = prompt.Parent
                    if plant and plant:IsA("BasePart") then
                        local distance = (plant.Position - strikePos).Magnitude
                        -- ถ้าสายฟ้าลงใกล้ต้นไม้ (ระยะไม่เกิน 15) ให้กดเก็บผลผลิตทันที!
                        if distance < 15 then
                            fireproximityprompt(prompt)
                        end
                    end
                end
            end
        end
    end)
end)

-- (ระบบสำรอง) เผื่อบางเกมไม่ได้ใช้สายฟ้าเป็นออบเจกต์เกิดใหม่ แต่เป็นสีแดง
task.spawn(function()
    while task.wait(0.2) do
        if Settings.AutoHarvest then
            pcall(function()
                local prompts = getPrompts()
                for _, prompt in pairs(prompts) do
                    -- เช็คว่าถ้าปุ่มนี้เป็นปุ่ม "เก็บผลผลิต" (Harvest)
                    if prompt.ActionText:lower():find("harvest") or prompt.ActionText:lower():find("collect") then
                        -- ปล่อยไว้ให้ตัวคูณเด้ง (ระบบ DescendantAdded ด้านบนจะเป็นตัวชิงกดก่อนฟ้าผ่า)
                        -- แต่ถ้าระบบด้านบนไม่ทำงาน ให้กดเก็บเมื่อตัวคูณถึงจุดที่ต้องการ (ถ้าเกมมีบอก)
                    end
                end
            end)
        end
    end
end)

-- ================= 3. ระบบขายอัตโนมัติ =================
task.spawn(function()
    while task.wait(1) do
        if Settings.AutoSell then
            pcall(function()
                -- หาปุ่มขาย (ถ้าเกมใช้ปุ่มกด)
                local prompts = getPrompts()
                for _, prompt in pairs(prompts) do
                    if prompt.ActionText:lower():find("sell") or prompt.ObjectText:lower():find("sell") then
                        fireproximityprompt(prompt)
                    end
                end
                
                -- ยิง RemoteEvent ขาย (ถ้าเกมใช้ Remote)
                local sellRemote1 = ReplicatedStorage:FindFirstChild("Sell", true)
                local sellRemote2 = ReplicatedStorage:FindFirstChild("SellAll", true)
                if sellRemote1 and sellRemote1:IsA("RemoteEvent") then sellRemote1:FireServer() end
                if sellRemote2 and sellRemote2:IsA("RemoteEvent") then sellRemote2:FireServer() end
            end)
        end
    end
end)
