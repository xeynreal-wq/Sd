-- ==========================================
-- ตัวแปรระบบ
-- ==========================================
local FreecamOn, UIHidden, ShaderOn = false, false, false
local CamSpeed = 1.0
local Pitch, Yaw = 0, 0
local MoveKeys = {W=false, A=false, S=false, D=false, Q=false, E=false}
local RightClicking = false
local Effects = {}
local SavedUI = {}

-- ==========================================
-- ระบบ Slider ความเร็ว
-- ==========================================
local draggingSlider = false
SliderBtn.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 then draggingSlider = true end
end)
UserInputService.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 then draggingSlider = false end
end)
UserInputService.InputChanged:Connect(function(input)
    if draggingSlider and input.UserInputType == Enum.UserInputType.MouseMovement then
        local pct = math.clamp((input.Position.X - SliderBG.AbsolutePosition.X) / SliderBG.AbsoluteSize.X, 0.05, 1)
        SliderFill.Size = UDim2.new(pct, 0, 1, 0)
        CamSpeed = pct * 5 -- ความเร็วตั้งแต่ 0.25 ถึง 5.0
        SpeedLabel.Text = string.format("ความเร็วกล้อง: %.1f", CamSpeed)
    end
end)

