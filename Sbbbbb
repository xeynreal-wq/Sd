-- ระบบ กล้องอิสระ (แก้บั๊กสมบูรณ์ 100%)
-- ==========================================
BtnFreecam.MouseButton1Click:Connect(function()
    FreecamOn = not FreecamOn
    local hrp = Player.Character and Player.Character:FindFirstChild("HumanoidRootPart")
    
    if FreecamOn then
        BtnFreecam.Text = "❌ ปิดกล้องอิสระ"
        BtnFreecam.BackgroundColor3 = Color3.fromRGB(180, 60, 60)
        
        Camera.CameraType = Enum.CameraType.Scriptable
        local x, y, z = Camera.CFrame:ToEulerAnglesYXZ()
        Pitch, Yaw = x, y -- จดจำมุมปัจจุบัน
        
        if hrp then hrp.Anchored = true end -- ล็อกตัวละครไม่ให้ตก
    else
        BtnFreecam.Text = "📷 เปิดกล้องอิสระ"
        BtnFreecam.BackgroundColor3 = Color3.fromRGB(50, 50, 50)
        Camera.CameraType = Enum.CameraType.Custom
        Camera.CameraSubject = Player.Character and Player.Character:FindFirstChild("Humanoid")
        if hrp then hrp.Anchored = false end
    end
end)

-- รับปุ่มคีย์บอร์ด
UserInputService.InputBegan:Connect(function(input, gp)
    if gp then return end
    if input.KeyCode == Enum.KeyCode.W then MoveKeys.W = true end
    if input.KeyCode == Enum.KeyCode.S then MoveKeys.S = true end
    if input.KeyCode == Enum.KeyCode.A then MoveKeys.A = true end
    if input.KeyCode == Enum.KeyCode.D then MoveKeys.D = true end
    if input.KeyCode == Enum.KeyCode.E then MoveKeys.E = true end -- ขึ้น (E)
    if input.KeyCode == Enum.KeyCode.Q then MoveKeys.Q = true end -- ลง (Q)
    if input.UserInputType == Enum.UserInputType.MouseButton2 then RightClicking = true end
end)

UserInputService.InputEnded:Connect(function(input)
    if input.KeyCode == Enum.KeyCode.W then MoveKeys.W = false end
    if input.KeyCode == Enum.KeyCode.S then MoveKeys.S = false end
    if input.KeyCode == Enum.KeyCode.A then MoveKeys.A = false end
    if input.KeyCode == Enum.KeyCode.D then MoveKeys.D = false end
    if input.KeyCode == Enum.KeyCode.E then MoveKeys.E = false end
    if input.KeyCode == Enum.KeyCode.Q then MoveKeys.Q = false end
    if input.UserInputType == Enum.UserInputType.MouseButton2 then RightClicking = false end
end)

-- หันมุมกล้อง (เมาส์ขวา)
UserInputService.InputChanged:Connect(function(input)
    if FreecamOn and RightClicking and input.UserInputType == Enum.UserInputType.MouseMovement then
        Yaw = Yaw - math.rad(input.Delta.X * 0.4)
        Pitch = math.clamp(Pitch - math.rad(input.Delta.Y * 0.4), -math.pi/2 + 0.01, math.pi/2 - 0.01)
    end
end)

-- ลูปการเคลื่อนที่กล้อง (แก้บั๊กจมดิน)
RunService.RenderStepped:Connect(function()
    if FreecamOn then
        -- คำนวณแกนเคลื่อนที่
        local moveVec = Vector3.new(
            (MoveKeys.D and 1 or 0) - (MoveKeys.A and 1 or 0), -- ซ้ายขวา (X)
            (MoveKeys.E and 1 or 0) - (MoveKeys.Q and 1 or 0), -- ขึ้นลง (Y)
            (MoveKeys.S and 1 or 0) - (MoveKeys.W and 1 or 0)  -- หน้าหลัง (Z)
        )
        
        -- อัพเดทพิกัดโดยอิงจากมุมกล้องปัจจุบัน CFrame.new เพื่อไม่ให้กล้องจมดินเวลาเล็งลง
        Camera.CFrame = CFrame.new(Camera.CFrame.Position) * CFrame.fromEulerAnglesYXZ(Pitch, Yaw, 0)
        Camera.CFrame = Camera.CFrame * CFrame.new(moveVec * CamSpeed)
    end
end)
