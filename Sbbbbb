-- ระบบ Shader
-- ==========================================
BtnShader.MouseButton1Click:Connect(function()
    ShaderOn = not ShaderOn
    if ShaderOn then
        BtnShader.Text = "🌅 ปิดแสง Shader"
        BtnShader.BackgroundColor3 = Color3.fromRGB(200, 120, 50)
        Lighting.ClockTime = 17.5
        Lighting.EnvironmentDiffuseScale = 0.5
        
        local cc = Instance.new("ColorCorrectionEffect")
        cc.Contrast = 0.15 cc.Saturation = 0.5 cc.TintColor = Color3.fromRGB(255, 220, 180)
        cc.Parent = Lighting table.insert(Effects, cc)
        
        local bloom = Instance.new("BloomEffect")
        bloom.Intensity = 0.8 bloom.Size = 24
        bloom.Parent = Lighting table.insert(Effects, bloom)
        
        local sun = Instance.new("SunRaysEffect")
        sun.Intensity = 0.3 sun.Spread = 0.8
        sun.Parent = Lighting table.insert(Effects, sun)
    else
        BtnShader.Text = "🌅 เปิดแสง Shader ยามเย็น"
        BtnShader.BackgroundColor3 = Color3.fromRGB(50, 50, 50)
        Lighting.ClockTime = 14
        for _, v in pairs(Effects) do v:Destroy() end
        Effects = {}
    end
end)

-- ==========================================
-- ระบบ ซ่อน UI
-- ==========================================
BtnUI.MouseButton1Click:Connect(function()
    UIHidden = not UIHidden
    if UIHidden then
        BtnUI.Text = "👀 แสดง UI เกม"
        BtnUI.BackgroundColor3 = Color3.fromRGB(60, 120, 180)
        pcall(function() StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.All, false) end)
        
        table.clear(SavedUI)
        if Player:FindFirstChild("PlayerGui") then
            for _, gui in pairs(Player.PlayerGui:GetChildren()) do
                if gui:IsA("ScreenGui") and gui.Name ~= "CinematicHub" then
                    SavedUI[gui] = gui.Enabled
                    gui.Enabled = false
                end
            end
        end
    else
        BtnUI.Text = "👁️ ซ่อน UI เกม"
        BtnUI.BackgroundColor3 = Color3.fromRGB(50, 50, 50)
        pcall(function() StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.All, true) end)
        for gui, state in pairs(SavedUI) do
            if gui and gui.Parent then gui.Enabled = state end
        end
    end
end)

