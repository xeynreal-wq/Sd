-- ==========================================
-- ตัวแปรระบบ
-- ==========================================
local FreecamOn, UIHidden, ShaderOn, MenuHidden = false, false, false, false
local CamSpeed = 1.0
local Pitch, Yaw = 0, 0
local MoveKeys = {W=false, A=false, S=false, D=false, Up=false, Down=false}
local Effects = {}
local SavedUI = {}

-- ==========================================
-- ฟังก์ชั่นหลัก
-- ==========================================
local function ToggleFreecam()
    FreecamOn = not FreecamOn
    local hrp = Player.Character and Player.Character:FindFirstChild("HumanoidRootPart")
    
    if FreecamOn then
        BtnFreecam.Text = "❌ ปิดกล้องอิสระ [P]"
        BtnFreecam.BackgroundColor3 = Color3.fromRGB(180, 60, 60)
        
        Camera.CameraType = Enum.CameraType.Scriptable
        local x, y, z = Camera.CFrame:ToEulerAnglesYXZ()
        Pitch, Yaw = x, y
        if hrp then hrp.Anchored = true end
    else
        BtnFreecam.Text = "📷 กล้องอิสระ [P]"
        BtnFreecam.BackgroundColor3 = Color3.fromRGB(50, 50, 50)
        Camera.CameraType = Enum.CameraType.Custom
        Camera.CameraSubject = Player.Character and Player.Character:FindFirstChild("Humanoid")
        if hrp then hrp.Anchored = false end
        UserInputService.MouseBehavior = Enum.MouseBehavior.Default -- คืนค่าเมาส์
    end
end

local function ToggleShader()
    ShaderOn = not ShaderOn
    if ShaderOn then
        BtnShader.Text = "🌅 ปิด Shader [K]"
        BtnShader.BackgroundColor3 = Color3.fromRGB(200, 120, 50)
        Lighting.ClockTime = 17.5
        Lighting.EnvironmentDiffuseScale = 0.5
        
        local cc = Instance.new("ColorCorrectionEffect")
        cc.Contrast = 0.15 cc.Saturation = 0.5 cc.TintColor = Color3.fromRGB(255, 220, 180)
        cc.Parent = Lighting table.insert(Effects, cc)
        
        local bloom = Instance.new("BloomEffect")
        bloom.Intensity = 0.8 bloom.Size = 24
        bloom.Parent = Lighting table.insert(Effects, bloom)
        
        local sun = Instance.new("SunRaysEffect")
        sun.Intensity = 0.3 sun.Spread = 0.8
        sun.Parent = Lighting table.insert(Effects, sun)
    else
        BtnShader.Text = "🌅 Shader ยามเย็น [K]"
        BtnShader.BackgroundColor3 = Color3.fromRGB(50, 50, 50)
        Lighting.ClockTime = 14
        for _, v in pairs(Effects) do v:Destroy() end
        Effects = {}
    end
end

local function ToggleUI()
    UIHidden = not UIHidden
    if UIHidden then
        BtnUI.Text = "👀 แสดง UI เกม [L]"
        BtnUI.BackgroundColor3 = Color3.fromRGB(60, 120, 180)
        pcall(function() StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.All, false) end)
        
        table.clear(SavedUI)
        if Player:FindFirstChild("PlayerGui") then
            for _, gui in pairs(Player.PlayerGui:GetChildren()) do
                if gui:IsA("ScreenGui") and gui.Name ~= "CinematicHub" then
                    SavedUI[gui] = gui.Enabled
                    gui.Enabled = false
                end
            end
        end
    else
        BtnUI.Text = "👁️ ซ่อน UI เกม [L]"
        BtnUI.BackgroundColor3 = Color3.fromRGB(50, 50, 50)
        pcall(function() StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.All, true) end)
        for gui, state in pairs(SavedUI) do
            if gui and gui.Parent then gui.Enabled = state end
        end
    end
end

local function ToggleMenu()
    MenuHidden = not MenuHidden
    MainFrame.Visible = not MenuHidden
    OpenBtn.Visible = MenuHidden
end

-- ผูกปุ่ม UI
BtnFreecam.MouseButton1Click:Connect(ToggleFreecam)
BtnShader.MouseButton1Click:Connect(ToggleShader)
BtnUI.MouseButton1Click:Connect(ToggleUI)
BtnHideMenu.MouseButton1Click:Connect(ToggleMenu)
OpenBtn.MouseButton1Click:Connect(ToggleMenu)

-- Slider
local draggingSlider = false
SliderBtn.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 then draggingSlider = true end
end)
UserInputService.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 then draggingSlider = false end
end)
UserInputService.InputChanged:Connect(function(input)
    if draggingSlider and input.UserInputType == Enum.UserInputType.MouseMovement then
        local pct = math.clamp((input.Position.X - SliderBG.AbsolutePosition.X) / SliderBG.AbsoluteSize.X, 0.05, 1)
        SliderFill.Size = UDim2.new(pct, 0, 1, 0)
        CamSpeed = pct * 5 
        SpeedLabel.Text = string.format("ความเร็วกล้อง: %.1f", CamSpeed)
    end
end)

-- ==========================================
-- ระบบ Input (Hotkeys & Movement)
-- ==========================================
UserInputService.InputBegan:Connect(function(input, gp)
    if gp then return end
    
    -- คีย์ลัด (Hotkeys)
    if input.KeyCode == Enum.KeyCode.P then ToggleFreecam() end
    if input.KeyCode == Enum.KeyCode.L then ToggleUI() end
    if input.KeyCode == Enum.KeyCode.K then ToggleShader() end
    if input.KeyCode == Enum.KeyCode.M then ToggleMenu() end
    
    -- เดินกล้อง
    if input.KeyCode == Enum.KeyCode.W then MoveKeys.W = true end
    if input.KeyCode == Enum.KeyCode.S then MoveKeys.S = true end
    if input.KeyCode == Enum.KeyCode.A then MoveKeys.A = true end
    if input.KeyCode == Enum.KeyCode.D then MoveKeys.D = true end
    if input.KeyCode == Enum.KeyCode.Space then MoveKeys.Up = true end -- Spacebar บินขึ้น
    if input.KeyCode == Enum.KeyCode.LeftAlt then MoveKeys.Down = true end -- Left Alt บินลง
end)

UserInputService.InputEnded:Connect(function(input)
    if input.KeyCode == Enum.KeyCode.W then MoveKeys.W = false end
    if input.KeyCode == Enum.KeyCode.S then MoveKeys.S = false end
    if input.KeyCode == Enum.KeyCode.A then MoveKeys.A = false end
    if input.KeyCode == Enum.KeyCode.D then MoveKeys.D = false end
    if input.KeyCode == Enum.KeyCode.Space then MoveKeys.Up = false end
    if input.KeyCode == Enum.KeyCode.LeftAlt then MoveKeys.Down = false end
end)

-- หันมุมกล้อง 100% อิสระตามเมาส์ (ไม่ต้องกดค้าง)
UserInputService.InputChanged:Connect(function(input)
    if FreecamOn and input.UserInputType == Enum.UserInputType.MouseMovement then
        Yaw = Yaw - math.rad(input.Delta.X * 0.2)
        Pitch = math.clamp(Pitch - math.rad(input.Delta.Y * 0.2), -math.pi/2 + 0.01, math.pi/2 - 0.01)
    end
end)

-- ลูปอัพเดทกล้อง
RunService.RenderStepped:Connect(function()
    if FreecamOn then
        -- ล็อคเมาส์ไว้ตรงกลางจอเมื่อเปิดกล้อง
        UserInputService.MouseBehavior = Enum.MouseBehavior.LockCenter
        
        local moveVec = Vector3.new(
            (MoveKeys.D and 1 or 0) - (MoveKeys.A and 1 or 0), 
            (MoveKeys.Up and 1 or 0) - (MoveKeys.Down and 1 or 0), 
            (MoveKeys.S and 1 or 0) - (MoveKeys.W and 1 or 0)  
        )
        
        Camera.CFrame = CFrame.new(Camera.CFrame.Position) * CFrame.fromEulerAnglesYXZ(Pitch, Yaw, 0)
        Camera.CFrame = Camera.CFrame * CFrame.new(moveVec * CamSpeed)
    else
        -- คืนค่าเมาส์ถ้าปิดกล้อง
        if UserInputService.MouseBehavior == Enum.MouseBehavior.LockCenter then
            UserInputService.MouseBehavior = Enum.MouseBehavior.Default
        end
    end
end)
