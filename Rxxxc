-- ระบบนับคืนและคำนวณอายุเซิร์ฟเวอร์ (100% Accurate)
local serverStartTime = tick() - workspace.DistributedGameTime
local nightCount = 0
local isNight = false

task.spawn(function()
    while task.wait(1) do
        -- 1. คำนวณอายุเซิร์ฟเวอร์
        local totalSeconds = math.floor(workspace.DistributedGameTime)
        local hours = math.floor(totalSeconds / 3600)
        local mins = math.floor((totalSeconds % 3600) / 60)
        local secs = totalSeconds % 60
        
        -- 2. เช็คการผ่านของกลางคืน (Blox Fruits กลางคืนคือ ClockTime < 6 หรือ > 18)
        local clockTime = game:GetService("Lighting").ClockTime
        if (clockTime >= 18 or clockTime < 6) then
            if not isNight then
                isNight = true
                nightCount = nightCount + 1
            end
        else
            isNight = false
        end

        -- อัปเดตข้อความบน UI
        InfoLabel.Text = string.format(
            " [ข้อมูลเซิร์ฟเวอร์]\n • อายุเซิร์ฟ: %d ชม. %d นาที %d วิ\n • ผ่านกลางคืนมาแล้ว: %d คืน\n • สถานะตอนนี้: %s",
            hours, mins, secs, nightCount, isNight and "กลางคืน 🌙" or "กลางวัน ☀️"
        )
    end
end)

-- ฟังก์ชั่นมองสว่าง + ESP สีฟ้า
HighlightBtn.MouseButton1Click:Connect(function()
    local Lighting = game:GetService("Lighting")
    Lighting.FogEnd = 9e9
    Lighting.FogStart = 9e9
    Lighting.Brightness = 5
    Lighting.ClockTime = 12
    Lighting.GlobalShadows = false

    local found = false
    for _, v in pairs(workspace:GetDescendants()) do
        if v.Name == "Gear" or v.Name == "MysticGear" then
            found = true
            local hl = Instance.new("Highlight")
            hl.Parent = v
            hl.FillColor = Color3.fromRGB(0, 255, 255)
            hl.OutlineColor = Color3.fromRGB(255, 255, 255)
            hl.FillTransparency = 0
            hl.OutlineTransparency = 0
        end
    end
    
    if found then
        HighlightBtn.Text = "เจอเฟืองแล้ว! (สว่างฟ้า)"
        HighlightBtn.BackgroundColor3 = Color3.fromRGB(0, 230, 100)
    else
        HighlightBtn.Text = "ไม่พบเฟือง (เปิดสว่างแล้ว)"
    end
end)

-- ฟังก์ชั่นวาร์ป
TPBtn.MouseButton1Click:Connect(function()
    local player = game.Players.LocalPlayer
    local character = player.Character or player.CharacterAdded:Wait()
    local hrp = character:FindFirstChild("HumanoidRootPart")
    
    local targetGear = nil
    for _, v in pairs(workspace:GetDescendants()) do
        if v.Name == "Gear" or v.Name == "MysticGear" then
            targetGear = v
            break
        end
    end

    if targetGear and hrp then
        hrp.CFrame = targetGear.CFrame * CFrame.new(0, 3, 0)
        TPBtn.Text = "วาร์ปสำเร็จ!"
        TPBtn.BackgroundColor3 = Color3.fromRGB(0, 230, 100)
    else
        TPBtn.Text = "ยังไม่มีเฟืองเกิดในแมพ"
    end
end)
